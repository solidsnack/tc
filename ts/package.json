{
    "name": "timecode",
    "version": "0.1.0",
    "private": true,
    "description": "TimeCodes: sortable, short timestamps",
    "license": "Unlicense",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "bin": {
        "timecode": "./dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20.11"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "pretest": "tsc",
        "test": "node --test 'build/test/**/*.test.js'",
        "fmt": "dprint fmt",
        "fmt:check": "dprint check",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@optique/core": "^1.3.3",
        "@optique/run": "^1.3.3",
        "temporal-polyfill": "^1.0.5"
    },
    "devDependencies": {
        "@dprint/json": "^0.25.2",
        "@dprint/markdown": "^0.26.0",
        "@dprint/typescript": "^0.96.1",
        "@types/node": "^25.9.9",
        "dprint": "^0.61.1",
        "fast-check": "^4.10.2",
        "typescript": "^6.0.3",
        "yaml": "^2.9.1"
    }
}
